# MedGuard Backend Environment Variables
#
# Copy to backend/.env and fill in real values. NEVER commit a filled .env.
# Every value below is a PLACEHOLDER.

# --- Model artifact --------------------------------------------------------
# Path to the trained Triagegeist pipeline, relative to the repository root.
# The artifact is small enough to commit but is kept remote for consistency.
# See docs/RENDER_DEPLOYMENT_FIX.md for the three ways to
# make it available in production.
MEDGUARD_MODEL_PATH=models/triagegeist/triage_model.joblib

# Path to the model manifest (metadata, <1 KB).
MEDGUARD_MANIFEST_PATH=models/triagegeist/triage_model.manifest.json

# --- Remote artifact delivery ---------------------------------------------
# The trained artifact is stored xz-compressed (~8 KB) in a PRIVATE bucket and
# restored by the service at startup. The digest is of the RESTORED artifact
# and is verified before it is loaded.
#
# Choose EITHER direct URLs (below) OR bucket + object paths (next block),
# not both. Direct URLs take precedence when set.
MEDGUARD_MODEL_URL=https://tpzfaulcjcvleupjlufu.supabase.co/storage/v1/object/model-artifacts/triagegeist/v1.0/triage_model.joblib.xz
MEDGUARD_MODEL_SHA256=df0d5de3a0405894b1e45eba210221f1c19be4bcb89788bef2ef59906510a4b4
MEDGUARD_MANIFEST_URL=https://tpzfaulcjcvleupjlufu.supabase.co/storage/v1/object/model-artifacts/triagegeist/v1.0/triage_model.manifest.json
MEDGUARD_MANIFEST_SHA256=04ef6aa5c601ae1ab0f3ce1bf8b532659e3e411e6873c4a3d0516e14406f119b
MEDGUARD_ARTIFACT_DIR=/tmp/medguard-artifacts

# --- Supabase Storage bucket + object paths (alternative to direct URLs) ---
# Explicit, least-privilege location of each artifact in a private bucket.
# The bucket holds versioned model artifacts only — never the training dataset.
MEDGUARD_ARTIFACT_BUCKET=model-artifacts
MEDGUARD_ARTIFACT_MODEL_OBJECT=triagegeist/v1.0/triage_model.joblib.xz
MEDGUARD_ARTIFACT_MANIFEST_OBJECT=triagegeist/v1.0/triage_model.manifest.json

# --- Transfer controls ------------------------------------------------------
MEDGUARD_ARTIFACT_TIMEOUT=300
MEDGUARD_ARTIFACT_RETRIES=3

# --- Data ------------------------------------------------------------------
# Root of the Triagegeist synthetic dataset. Only needed for the training and
# reporting pipelines; inference serves the model artifact alone.
MEDGUARD_DATA_ROOT=triagegeist

# --- CORS ------------------------------------------------------------------
# Exact browser origins allowed to call this API, comma-separated. The
# deployed Vercel frontend and its preview deployments.
MEDGUARD_CORS_ORIGINS=https://med-guard-livid.vercel.app,https://med-guard-mambo-lits-projects.vercel.app
# Optional regular expression for preview domains that are not known in
# advance. Leave unset to allow only the exact origins above.
MEDGUARD_CORS_ORIGIN_REGEX=https://med-guard-.*\.vercel\.app
# "1" allows ANY origin and disables credentials (local development only).
MEDGUARD_ALLOW_FOREIGN_ORIGIN=false

# --- Supabase ---------------------------------------------------------------
# Backend-only credentials. NEVER expose the service-role key to the browser:
# it bypasses Row Level Security. Rotate it if it was ever committed or
# shared, and set it only in the Render dashboard.
SUPABASE_URL=https://tpzfaulcjcvleupjlufu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<backend-only service-role key: set in the Render dashboard>
