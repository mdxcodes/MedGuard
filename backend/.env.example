# MedGuard Backend Environment Variables
#
# Copy to backend/.env and fill in real values. NEVER commit a filled .env.
# Every value below is a PLACEHOLDER.

# --- Model artifact --------------------------------------------------------
# Path to the trained Triagegeist pipeline, relative to the repository root.
# The artifact is ~250 MB and is therefore NOT committed (GitHub's limit is
# 100 MB per file). See docs/RENDER_DEPLOYMENT_FIX.md for the three ways to
# make it available in production.
MEDGUARD_MODEL_PATH=models/triagegeist/triage_model.joblib

# Path to the model manifest (metadata, <1 KB).
MEDGUARD_MANIFEST_PATH=models/triagegeist/triage_model.manifest.json

# --- Remote artifact delivery (optional) -----------------------------------
# When the artifact is not present on disk it is fetched once from these URLs
# into MEDGUARD_ARTIFACT_DIR and verified against the SHA-256 digests.
# Any value that does not match its digest is rejected.
# MEDGUARD_MODEL_URL=https://<storage-host>/<bucket>/triage_model.joblib
# MEDGUARD_MODEL_SHA256=<sha256 of the joblib artifact>
# MEDGUARD_MANIFEST_URL=https://<storage-host>/<bucket>/triage_model.manifest.json
# MEDGUARD_MANIFEST_SHA256=<sha256 of the manifest>
# MEDGUARD_ARTIFACT_DIR=/tmp/medguard-artifacts

# --- Data ------------------------------------------------------------------
# Root of the Triagegeist synthetic dataset. Only needed for the training and
# reporting pipelines; inference serves the model artifact alone.
MEDGUARD_DATA_ROOT=triagegeist

# --- CORS ------------------------------------------------------------------
# "1" allows any origin (local development and tests only). In production
# leave this unset and allow the deployed frontend origin explicitly.
MEDGUARD_ALLOW_FOREIGN_ORIGIN=false

# --- Supabase (optional) ----------------------------------------------------
# Backend-only credentials. NEVER expose the service-role key to the browser:
# it bypasses Row Level Security. Create a new key if the previous one was
# ever committed or shared.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<backend-only service-role key>
# SUPABASE_STORAGE_BUCKET=<private bucket for model artifacts>
