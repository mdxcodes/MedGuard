# MedGuard Frontend Environment Variables
#
# Copy to frontend/.env and fill in real values. NEVER commit a filled .env.
# Only variables prefixed with VITE_ are exposed to the browser bundle, so
# nothing secret may ever be placed here.

# --- Backend API -----------------------------------------------------------
# Base URL of the deployed FastAPI service (Render). Leave as the local
# address for local development.
VITE_API_BASE_URL=http://localhost:8000

# --- Supabase (optional) ----------------------------------------------------
# The publishable/anon key only. It is designed to be public and is only
# safe while Row Level Security and Storage policies are enforced.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<publishable/anon key>
